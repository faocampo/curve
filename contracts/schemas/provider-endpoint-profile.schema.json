{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/provider-endpoint-profile.schema.json",
  "title": "Curve candidate provider endpoint-profile metadata",
  "description": "Candidate-only metadata projection for M0-S9B2. It contains no endpoint, origin, DNS name, certificate, signature key, or callback value and is not normative until B-PROFILE-M0-S9B2 is approved.",
  "x-curve-contract-state": "PROPOSED_NOT_NORMATIVE",
  "x-curve-promotion-decision": "B-PROFILE-M0-S9B2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "provider_connection_id",
    "profile_version",
    "environment",
    "endpoint_profile_kind",
    "transport_protocol",
    "tls_policy",
    "source_policy",
    "status",
    "endpoint_value_present"
  ],
  "properties": {
    "schema_version": { "const": "curve.provider-endpoint-profile/v1-candidate" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "provider_connection_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
    "profile_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
    "environment": { "enum": ["LOCAL", "STAGING", "PRODUCTION"] },
    "endpoint_profile_kind": { "type": "null" },
    "transport_protocol": { "type": "null" },
    "tls_policy": { "type": "null" },
    "source_policy": { "type": "null" },
    "status": { "const": "UNCONFIGURED" },
    "endpoint_value_present": { "const": false }
  }
}
