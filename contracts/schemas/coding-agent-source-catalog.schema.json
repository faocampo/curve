{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/coding-agent-source-catalog.schema.json",
  "title": "Curve coding-agent source catalog",
  "description": "Machine-readable work-package catalog published after normative and evidence inputs, and before the sealed task-packet registry, for dispatch preflight.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "work_packages"],
  "properties": {
    "schema_version": { "const": "curve.coding-agent-source-catalog/v1" },
    "catalog_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workPackage" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_package_id", "packet_id", "workspace_id", "packet_projection_digest", "size", "user_facing", "risk_tier", "repository",
        "requirements", "dependencies", "decisions", "project_tracking", "commands",
        "contract_applicability"
      ],
      "properties": {
        "work_package_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
        "packet_id": { "type": "string", "pattern": "^CURVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "workspace_id": { "type": "string", "format": "uuid" },
        "packet_projection_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "size": { "enum": ["S", "M", "L"] },
        "user_facing": { "type": "boolean" },
        "risk_tier": { "enum": ["LOW", "STANDARD", "HIGH"] },
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "target_branch"],
          "properties": {
            "url": { "$ref": "#/$defs/id" },
            "target_branch": { "$ref": "#/$defs/id" }
          }
        },
        "requirements": {
          "type": "object", "additionalProperties": false,
          "required": ["functional_requirement_ids", "non_functional_requirement_ids"],
          "properties": {
            "functional_requirement_ids": { "$ref": "#/$defs/stringList" },
            "non_functional_requirement_ids": { "$ref": "#/$defs/stringList" }
          }
        },
        "dependencies": { "$ref": "#/$defs/stringList" },
        "decisions": { "$ref": "#/$defs/stringList" },
        "project_tracking": {
          "type": "object", "additionalProperties": false,
          "required": ["project_number", "item_node_id", "tracking_kind"],
          "properties": {
            "project_number": { "type": "integer", "minimum": 1 },
            "item_node_id": { "type": "string", "pattern": "^PVTI_[A-Za-z0-9_-]+$" },
            "tracking_kind": { "enum": ["WORK_PACKAGE", "DEFINITION_EVIDENCE"] }
          }
        },
        "commands": {
          "type": "array", "minItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "phase", "argv", "working_directory", "timeout_seconds", "availability", "tool_id", "network_destination_ids", "external_effect_ids"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "phase": { "$ref": "#/$defs/id" },
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "working_directory": { "$ref": "#/$defs/id" },
              "timeout_seconds": { "type": "integer", "minimum": 1 },
              "availability": { "enum": ["AVAILABLE", "PLANNED"] },
              "tool_id": { "$ref": "#/$defs/id" },
              "network_destination_ids": { "$ref": "#/$defs/stringList" },
              "external_effect_ids": { "$ref": "#/$defs/stringList" }
            }
          }
        },
        "contract_applicability": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["category", "applicability", "contract_id"],
            "properties": {
              "category": { "enum": ["API", "SCHEMA", "EVENT", "WORKFLOW", "POLICY", "PERSISTENCE", "MIGRATION"] },
              "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE", "REQUIRED_UNRESOLVED"] },
              "contract_id": {
                "oneOf": [
                  { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$" },
                  { "type": "null" }
                ]
              }
            },
            "allOf": [{
              "if": {
                "properties": { "applicability": { "const": "APPLICABLE" } },
                "required": ["applicability"]
              },
              "then": {
                "properties": {
                  "contract_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$" }
                }
              },
              "else": {
                "properties": { "contract_id": { "type": "null" } }
              }
            }]
          }
        }
      }
    }
  }
}
