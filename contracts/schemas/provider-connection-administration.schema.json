{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/provider-connection-administration.schema.json",
  "title": "Curve provider-connection administration response",
  "description": "Candidate-only M0-S9B1 safe response projection. It is not normative until B-ADMIN-M0-S9B1 is approved and the successor OpenAPI contract is materialized.",
  "x-curve-contract-state": "PROPOSED_NOT_NORMATIVE",
  "x-curve-promotion-decision": "B-ADMIN-M0-S9B1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "aggregate_version",
    "provider_type",
    "adapter_key",
    "adapter_version",
    "environment",
    "display_name",
    "allowed_classifications",
    "status",
    "current_capability",
    "validated_at",
    "last_reconciled_at",
    "next_reconcile_at",
    "last_error",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "curve.provider-connection-administration/v1" },
    "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "aggregate_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
    "provider_type": {
      "type": "string",
      "enum": [
        "FAKE_LOCAL",
        "ONYX",
        "MCP",
        "ORCA_HUMAN_ASSISTANCE",
        "MODEL_GATEWAY",
        "OPENHANDS",
        "GITHUB",
        "GITLAB",
        "QUALITY",
        "FEATURE_FLAG",
        "DOCUMENTATION",
        "MONITORING",
        "PROTOTYPE"
      ]
    },
    "adapter_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,99}$"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "environment": {
      "type": "string",
      "enum": ["LOCAL", "STAGING", "PRODUCTION"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "allowed_classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/DataClassification" }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_VALIDATION", "ACTIVE", "DEGRADED", "DISABLED", "REVOKED"]
    },
    "current_capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability_version", "capability_digest"],
          "properties": {
            "capability_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
            "capability_digest": { "$ref": "common.schema.json#/$defs/Digest" }
          }
        },
        { "type": "null" }
      ]
    },
    "validated_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Instant" }, { "type": "null" }]
    },
    "last_reconciled_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Instant" }, { "type": "null" }]
    },
    "next_reconcile_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Instant" }, { "type": "null" }]
    },
    "last_error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,99}$" },
            "retryable": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Instant" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Instant" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["ACTIVE", "DEGRADED"] } } },
      "then": {
        "properties": {
          "current_capability": { "type": "object" },
          "validated_at": { "$ref": "common.schema.json#/$defs/Instant" },
          "last_reconciled_at": { "$ref": "common.schema.json#/$defs/Instant" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } } },
      "then": {
        "properties": {
          "next_reconcile_at": { "$ref": "common.schema.json#/$defs/Instant" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "DEGRADED" } } },
      "then": {
        "properties": {
          "last_error": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["DISABLED", "REVOKED"] } } },
      "then": {
        "properties": {
          "next_reconcile_at": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "provider_type": { "const": "FAKE_LOCAL" } } },
      "then": {
        "properties": {
          "adapter_key": { "const": "curve.fake-local" },
          "adapter_version": { "const": "1.0.0" },
          "environment": { "const": "LOCAL" },
          "allowed_classifications": { "const": ["INTERNAL"] }
        }
      }
    }
  ]
}
