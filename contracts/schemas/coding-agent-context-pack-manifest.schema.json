{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/coding-agent-context-pack-manifest.schema.json",
  "title": "Curve coding-agent context-pack manifest",
  "description": "Versioned manifest for the exact Curve blobs included in a coding-agent context pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_pack_id", "version", "workspace_id", "work_package_id", "curve_revision", "entries"],
  "properties": {
    "schema_version": { "const": "curve.coding-agent-context-pack-manifest/v1" },
    "context_pack_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "integer", "minimum": 1 },
    "workspace_id": { "type": "string", "format": "uuid" },
    "work_package_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
    "curve_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Normative Curve source revision for every entry. The manifest blob is published later and is referenced by its own commit from the task packet."
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "path", "revision", "content_digest"],
        "properties": {
          "repository": { "const": "CURVE" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
