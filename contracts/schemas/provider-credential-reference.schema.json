{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/provider-credential-reference.schema.json",
  "title": "Curve candidate provider credential-reference metadata",
  "description": "Candidate-only metadata projection for M0-S9B2. It contains no credential, secret, broker locator, or concrete reference syntax and is not normative until B-PROFILE-M0-S9B2 is approved.",
  "x-curve-contract-state": "PROPOSED_NOT_NORMATIVE",
  "x-curve-promotion-decision": "B-PROFILE-M0-S9B2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "provider_connection_id",
    "profile_version",
    "reference_kind",
    "reference_format_version",
    "status",
    "rotation_due_at",
    "revoked_at",
    "credential_material_present"
  ],
  "properties": {
    "schema_version": { "const": "curve.provider-credential-reference/v1-candidate" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "provider_connection_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
    "profile_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
    "reference_kind": { "type": "null" },
    "reference_format_version": { "type": "null" },
    "status": { "const": "UNCONFIGURED" },
    "rotation_due_at": { "type": "null" },
    "revoked_at": { "type": "null" },
    "credential_material_present": { "const": false }
  }
}
