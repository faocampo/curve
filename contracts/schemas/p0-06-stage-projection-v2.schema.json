        "attempt_manifest_digest",
        "attempt_manifest_schema_path",
        "attempt_manifest_schema_digest",
        "operation_bindings_digest",
        "operation_binding_claim_sha",
        "operation_binding_evidence_sha",
        "operation_binding_reconciliation_evidence_ref",
        "operation_binding_reconciliation_evidence_sha",
        "operation_binding_terminal_projection_bootstrap_sha",
        "operation_binding_terminal_projection_final_sha",
        "attempt_approval_url",
        "preflight_report_path",
        "preflight_digest",
        "preflight_completed_at",
        "preflight_expires_at",
        "trusted_controller_principal",
        "controller_source_revision",
        "controller_executable_path",
        "controller_executable_digest",
        "controller_config_path",
        "controller_config_digest",
        "controller_conformance_report_path",
        "controller_conformance_digest",
        "controller_operation_allowlist_path",
        "controller_operation_allowlist_digest",
        "broker_conformance_report_path",
        "broker_conformance_report_digest",
        "broker_claim_ruleset_recheck_policy_path",
        "broker_claim_ruleset_recheck_policy_digest",
