{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/p0-06-stage-projection-v2.schema.json",
  "title": "Curve P0-06 two-stage local Temporal proof projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "current_stage", "updated_on", "stages"],
  "properties": {
    "schema_version": { "const": "curve.proof-stage-projection/v2" },
    "task_id": { "const": "P0-06" },
    "current_stage": {
      "type": "string",
      "enum": ["P0-06A_DESIGN", "P0-06A_READY", "P0-06A_REVIEWED"]
    },
    "updated_on": { "type": "string", "format": "date" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0-06A", "P0-06B"],
      "properties": {
        "P0-06A": { "$ref": "#/$defs/stageA" },
        "P0-06B": { "$ref": "#/$defs/stageBUnavailable" }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instant": { "type": "string", "format": "date-time" },
    "nullableSha": {
      "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
    },
    "nullableDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "nullableInstant": {
      "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }]
    },
    "nullableString": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000
    },
    "nullableHttpsUri": {
      "oneOf": [
        { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
        { "type": "null" }
      ]
    },
    "checkBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "app_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "app_id": { "type": "integer", "minimum": 1 }
      }
    },
    "checkList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/checkBinding" }
    },
    "requiredChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation_head",
        "documentation_merge",
        "harness_head",
        "harness_merge",
        "attempt_head",
        "attempt_merge",
        "projection_head",
        "projection_merge",
        "evidence_head",
        "evidence_merge",
        "terminal_projection_head",
        "terminal_projection_merge"
      ],
      "properties": {
        "documentation_head": { "$ref": "#/$defs/checkList" },
        "documentation_merge": { "$ref": "#/$defs/checkList" },
        "harness_head": { "$ref": "#/$defs/checkList" },
        "harness_merge": { "$ref": "#/$defs/checkList" },
        "attempt_head": { "$ref": "#/$defs/checkList" },
        "attempt_merge": { "$ref": "#/$defs/checkList" },
        "projection_head": { "$ref": "#/$defs/checkList" },
        "projection_merge": { "$ref": "#/$defs/checkList" },
