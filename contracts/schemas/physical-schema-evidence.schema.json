{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/schemas/physical-schema-evidence.schema.json",
  "title": "Curve physical schema evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_key",
    "evidence_scope",
    "plane_revision",
    "plane_tree",
    "captured_at",
    "migration_boundary",
    "sources",
    "tables"
  ],
  "properties": {
    "schema_version": { "const": "curve.physical-schema-evidence/v1" },
    "evidence_key": { "type": "string", "pattern": "^[A-Z0-9_-]{3,100}$" },
    "evidence_scope": { "const": "INDEX_EXISTENCE" },
    "plane_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "plane_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "captured_at": { "type": "string", "format": "date" },
    "migration_boundary": { "type": "string", "minLength": 1, "maxLength": 255 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "git_blob", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "git_blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "introduced_by", "indexes", "new_index_migration_required"],
        "properties": {
          "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
          "introduced_by": { "type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+$" },
          "new_index_migration_required": { "type": "boolean" },
          "indexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "columns", "unique", "implementation", "forward_sql", "reverse_sql"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
                },
                "unique": { "type": "boolean" },
                "implementation": {
                  "enum": ["DJANGO_FIELD", "DJANGO_INDEX", "DJANGO_UNIQUE_CONSTRAINT", "DJANGO_RUNSQL"]
                },
                "forward_sql": { "type": ["string", "null"] },
                "reverse_sql": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
