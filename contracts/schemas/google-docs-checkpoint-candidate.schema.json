{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/schemas/google-docs-checkpoint-candidate.schema.json",
  "title": "Synthetic Google Docs checkpoint candidate",
  "description": "Synthetic-only conformance envelope: provider-neutral checkpoint metadata plus inline test content. Runtime records expose only normalized_content_ref; retained bodies require approved protected storage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "workspace_id", "initiative_id", "external_document_binding_id", "provider_connection_id", "artifact_kind", "provider_file_id", "provider_container_id", "provider_version", "revision_id", "checkpoint_id", "checkpoint_number", "checkpoint_type", "predecessor_id", "submitted_or_approved_by", "recorded_at", "evidence_snapshot_id", "access_evaluation_id", "normalized_content_ref", "normalized_content", "content_digest"],
  "properties": {
    "schema_version": { "const": "curve.google-docs.checkpoint/v1-candidate" },
    "synthetic": { "const": true },
    "workspace_id": { "$ref": "#/$defs/id" },
    "initiative_id": { "$ref": "#/$defs/id" },
    "external_document_binding_id": { "$ref": "#/$defs/id" },
    "provider_connection_id": { "$ref": "#/$defs/id" },
    "artifact_kind": { "const": "PRD" },
    "checkpoint_number": { "type": "integer", "minimum": 1 },
    "checkpoint_type": { "const": "SUBMITTED" },
    "normalized_content_ref": { "$ref": "#/$defs/id" },
    "provider_file_id": { "$ref": "#/$defs/id" },
    "provider_container_id": { "$ref": "#/$defs/id" },
    "provider_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "revision_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "checkpoint_id": { "$ref": "#/$defs/id" },
    "predecessor_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "submitted_or_approved_by": { "$ref": "#/$defs/id" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "evidence_snapshot_id": { "$ref": "#/$defs/id" },
    "access_evaluation_id": { "$ref": "#/$defs/id" },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalized_content": {
      "type": "object",
      "required": ["normalization_version", "complete", "unsupported_nodes", "tabs"],
      "properties": {
        "normalization_version": { "const": "curve.google-docs.normalized/v1-candidate" },
        "complete": { "const": true },
        "unsupported_nodes": { "const": 0 },
        "tabs": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      },
      "description": "Synthetic normalized JSON only; the complete Google structure normalization schema is a prerequisite for a live adapter."
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1 } }
}
