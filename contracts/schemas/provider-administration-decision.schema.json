{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/schemas/provider-administration-decision.schema.json",
  "title": "Curve M0-S9B1 provider-administration decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_version",
    "work_package",
    "status",
    "decision_outcome",
    "last_updated",
    "baseline",
    "fixed_invariants",
    "api_contract",
    "safe_projection",
    "material_options",
    "dependency_evidence",
    "proof_cases",
    "owners",
    "approvals",
    "decided_at",
    "next_review_at",
    "decision_payload_digest",
    "activation",
    "unresolved_requirements",
    "implementation_dispatch_allowed"
  ],
  "properties": {
    "schema_version": { "const": "curve.provider-administration-decision/v1" },
    "decision_id": { "const": "B-ADMIN-M0-S9B1" },
    "decision_version": { "const": 1 },
    "work_package": { "const": "M0-S9B1" },
    "status": { "type": "string", "enum": ["PROPOSED", "DECIDED"] },
    "decision_outcome": {
      "type": "string",
      "enum": ["UNSELECTED", "APPROVED", "DEFERRED"]
    },
    "last_updated": { "$ref": "common.schema.json#/$defs/Instant" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "fixed_invariants": { "$ref": "#/$defs/fixedInvariants" },
    "api_contract": { "$ref": "#/$defs/apiContract" },
    "safe_projection": { "$ref": "#/$defs/safeProjection" },
    "material_options": { "$ref": "#/$defs/materialOptions" },
    "dependency_evidence": { "$ref": "#/$defs/dependencyEvidence" },
    "proof_cases": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/proofCase" }
    },
    "owners": { "$ref": "#/$defs/owners" },
    "approvals": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/approval" }
    },
    "decided_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Instant" },
        { "type": "null" }
      ]
    },
    "next_review_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Instant" },
        { "type": "null" }
      ]
    },
    "decision_payload_digest": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Digest" },
        { "type": "null" }
      ]
    },
    "activation": { "$ref": "#/$defs/activation" },
    "unresolved_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unresolvedRequirement" }
    },
    "implementation_dispatch_allowed": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PROPOSED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision_outcome": { "const": "UNSELECTED" },
          "material_options": { "$ref": "#/$defs/materialOptionsUnselected" },
          "approvals": { "maxItems": 0 },
          "decided_at": { "type": "null" },
          "next_review_at": { "type": "null" },
          "decision_payload_digest": { "type": "null" },
          "activation": { "$ref": "#/$defs/activationProposed" },
          "unresolved_requirements": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "DECIDED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision_outcome": {
            "type": "string",
            "enum": ["APPROVED", "DEFERRED"]
          },
          "owners": {
            "properties": {
              "security_identity_owner": { "$ref": "#/$defs/human" },
              "platform_administration_owner": { "$ref": "#/$defs/human" }
            }
          },
          "approvals": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": { "approval_role": { "const": "CURVE_PRODUCT" } },
                  "required": ["approval_role"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": { "approval_role": { "const": "SECURITY_IDENTITY" } },
                  "required": ["approval_role"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "approval_role": { "const": "PLATFORM_ADMINISTRATION" }
                  },
                  "required": ["approval_role"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "decided_at": { "$ref": "common.schema.json#/$defs/Instant" },
          "next_review_at": { "$ref": "common.schema.json#/$defs/Instant" },
          "decision_payload_digest": { "$ref": "common.schema.json#/$defs/Digest" },
          "activation": {
            "properties": { "decision_selected": { "const": true } }
          },
          "unresolved_requirements": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "decision_outcome": { "const": "APPROVED" } },
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {
          "status": { "const": "DECIDED" },
          "material_options": { "$ref": "#/$defs/materialOptionsApproved" },
          "proof_cases": {
            "items": {
              "properties": {
                "status": { "const": "PASS" },
                "evidence_refs": {
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/proofEvidenceRef" }
                }
              }
            }
          },
          "activation": { "$ref": "#/$defs/activationApproved" }
        }
      }
    },
    {
      "if": {
        "properties": { "decision_outcome": { "const": "DEFERRED" } },
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {
          "status": { "const": "DECIDED" },
          "material_options": { "$ref": "#/$defs/materialOptionsDeferred" },
          "dependency_evidence": { "$ref": "#/$defs/dependencyEvidenceEmpty" },
          "activation": { "$ref": "#/$defs/activationDeferred" }
        }
      }
    }
  ],
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surveyed_curve_revision",
        "observed_plane_preview_revision",
        "observed_plane_migration_head",
        "plane_migration_reserved",
        "parent_packet_version",
        "openapi_version",
        "core_policy_version",
        "core_policy_manifest_digest",
        "provider_connection_schema_version"
      ],
      "properties": {
        "surveyed_curve_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_plane_preview_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_plane_migration_head": {
          "type": "string",
          "pattern": "^[0-9]{4}_[a-z0-9_]+\\.py$"
        },
        "plane_migration_reserved": { "const": false },
        "parent_packet_version": { "const": "0.2" },
        "openapi_version": { "const": "1.1.0" },
        "core_policy_version": { "const": 2 },
        "core_policy_manifest_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "provider_connection_schema_version": { "const": "2.0" }
      }
    },
    "fixedInvariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_scope",
        "authorization_order",
        "cross_workspace_identifier_behavior",
        "caller_supplied_workspace",
        "caller_supplied_role",
        "agent_authority",
        "service_authority",
        "system_authority",
        "credential_resolution",
        "provider_network_access",
        "callback_processing",
        "outgoing_webhooks",
        "scheduled_reconciliation",
        "real_adapter_activation",
        "external_side_effect",
        "protected_body_persistence",
        "evidence_verification_boundary"
      ],
      "properties": {
        "workspace_scope": { "const": "EXACT_TARGET_WORKSPACE" },
        "authorization_order": {
          "const": "WORKSPACE_PREAUTH_BEFORE_SCOPED_SAFE_LOOKUP_THEN_RESOURCE_AUTH"
        },
        "cross_workspace_identifier_behavior": { "const": "SAME_AS_ABSENT" },
        "caller_supplied_workspace": { "const": "REJECT" },
        "caller_supplied_role": { "const": "REJECT" },
        "agent_authority": { "const": false },
        "service_authority": { "const": false },
        "system_authority": { "const": false },
        "credential_resolution": { "const": false },
        "provider_network_access": { "const": false },
        "callback_processing": { "const": false },
        "outgoing_webhooks": { "const": false },
        "scheduled_reconciliation": { "const": false },
        "real_adapter_activation": { "const": false },
        "external_side_effect": { "const": false },
        "protected_body_persistence": { "const": false },
        "evidence_verification_boundary": {
          "const": "DIGEST_BOUND_HUMAN_ATTESTATION"
        }
      }
    },
    "apiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_state",
        "api_prefix",
        "pagination",
        "idempotency_precondition_profile",
        "accepted_adapter_snapshot",
        "register_request",
        "response_contracts",
        "operations"
      ],
      "properties": {
        "contract_state": { "const": "PROPOSED_NOT_NORMATIVE" },
        "api_prefix": { "const": "/api/v1/workspaces/{workspace_slug}/curve" },
        "pagination": {
          "const": {
            "cursor_parameter": "cursor",
            "page_size_parameter": "page_size",
            "minimum_page_size": 1,
            "maximum_page_size": 100,
            "default_page_size": 25,
            "maximum_cursor_length": 4096,
            "response_cursor_field": "next_cursor"
          }
        },
        "idempotency_precondition_profile": {
          "const": {
            "request_digest": "SHA256_CANONICAL_REQUEST_BYTES",
            "record_payload": "STATUS_DIGEST_RESOURCE_REF_NO_RESPONSE_BODY",
            "matching_terminal_command": "RESOLVE_CURRENT_AUTHORIZED_SAFE_PROJECTION_FROM_STORED_RESOURCE_REF",
            "matching_pending_operation": "RETURN_SAME_OPERATION_AND_RESUME_DURABLE_PHASE",
            "replay_response_status": "ORIGINAL_STORED_STATUS",
            "replay_location": "STORED_RESOURCE_REF",
            "replay_response_etag": "CURRENT_RESOURCE_AGGREGATE_VERSION",
            "historical_response_body": "NOT_STORED",
            "unavailable_stored_resource_version": "IDEMPOTENCY_RECONCILIATION_REQUIRED_NO_EFFECT",
            "changed_request_digest": "HTTP_409_NO_EFFECT",
            "evaluation_order": [
              "AUTHORIZE_CURRENT_REQUEST_WITH_OPERATION_LOOKUP_SEQUENCE",
              "LOOKUP_IDEMPOTENCY_RECORD_BY_WORKSPACE_PRINCIPAL_COMMAND_AND_KEY_DIGEST",
              "REPLAY_OR_RESUME_MATCHING_REQUEST_DIGEST",
              "REJECT_CHANGED_REQUEST_DIGEST",
              "EVALUATE_IF_MATCH_FOR_NEW_COMMAND",
              "COMMIT_DOMAIN_EVENT_OUTBOX_AUDIT_AND_IDEMPOTENCY_ATOMICALLY"
            ],
            "missing_if_match": "HTTP_428_NO_EFFECT",
            "stale_if_match": "HTTP_412_NO_DOMAIN_OR_DELIVERY_EFFECT"
          }
        },
        "accepted_adapter_snapshot": {
          "const": {
            "contract_state": "ACCEPTED_M0_S9A_BASE",
            "source_schema_version": "curve.provider-registry/v1",
            "source_path": "contracts/providers/m0-s9a-provider-registry-v1.json",
            "source_content_digest": "sha256:ac9a7e854b917591f0c747d8ec55a6d051bcf6abe8680bbb341ca3763b368fbb",
            "accepted_coordinates": [
              {
                "provider_type": "FAKE_LOCAL",
                "adapter_key": "curve.fake-local",
                "adapter_version": "1.0.0",
                "environment": "LOCAL",
                "allowed_classifications": ["INTERNAL"]
              }
            ]
          }
        },
        "register_request": {
          "const": {
            "contract_state": "PROPOSED_NOT_NORMATIVE",
            "schema_version": "curve.provider-connection-register-request/v1",
            "schema_id": "https://curve.example.invalid/contracts/schemas/provider-connection-register-request.schema.json",
            "schema_path": "contracts/schemas/provider-connection-register-request.schema.json",
            "schema_content_digest": "sha256:2b692e7dfcace6690770d9eb85e8e392163794992dc975fb616db53427e2e597",
            "additional_properties": false,
            "required_fields": [
              "schema_version",
              "provider_type",
              "adapter_key",
              "adapter_version",
              "environment",
              "display_name",
              "allowed_classifications"
            ],
            "allowed_fields": [
              "schema_version",
              "provider_type",
              "adapter_key",
              "adapter_version",
              "environment",
              "display_name",
              "allowed_classifications"
            ],
            "blocked_fields": [
              "id",
              "workspace_id",
              "aggregate_version",
              "external_tenant_ref",
              "configuration_ref",
              "configuration_digest",
              "configuration_body",
              "secret_reference",
              "status",
              "created_by",
              "updated_by",
              "actor_roles"
            ],
            "provider_type_values": [
              "FAKE_LOCAL",
              "ONYX",
              "MCP",
              "ORCA_HUMAN_ASSISTANCE",
              "MODEL_GATEWAY",
              "OPENHANDS",
              "GITHUB",
              "GITLAB",
              "QUALITY",
              "FEATURE_FLAG",
              "DOCUMENTATION",
              "MONITORING",
              "PROTOTYPE"
            ],
            "environment_values": ["LOCAL", "STAGING", "PRODUCTION"],
            "classification_values": ["INTERNAL", "CONFIDENTIAL", "RESTRICTED"],
            "adapter_allowlist_source": "SERVER_SIDE_PROVIDER_REGISTRY",
            "caller_selected_workspace": false,
            "configuration_body_allowed": false
          }
        },
        "response_contracts": {
          "const": {
            "PROVIDER_CONNECTION_ADMINISTRATION_V1": {
              "contract_state": "PROPOSED_NOT_NORMATIVE",
              "schema_version": "curve.provider-connection-administration/v1",
              "schema_id": "https://curve.example.invalid/contracts/schemas/provider-connection-administration.schema.json",
              "schema_path": "contracts/schemas/provider-connection-administration.schema.json",
              "schema_content_digest": "sha256:56d085fec6167495ff9882134a243822041fde00bfde54b4c26ebfcd5babc80b"
            },
            "PROVIDER_CONNECTION_ADMINISTRATION_PAGE_V1": {
              "contract_state": "PROPOSED_NOT_NORMATIVE",
              "schema_version": "curve.provider-connection-administration-page/v1",
              "schema_id": "https://curve.example.invalid/contracts/schemas/provider-connection-administration-page.schema.json",
              "schema_path": "contracts/schemas/provider-connection-administration-page.schema.json",
              "schema_content_digest": "sha256:75ffb001ee7b0bae1ef5ca2a3dfe9af3319fc359ec881673de0d52cbaf44e1c9"
            },
            "OPERATION_SUMMARY_V1": {
              "contract_state": "ACCEPTED_BASE_REQUIRES_SELECTED_OPERATION_TYPE_MATERIALIZATION",
              "schema_version": "1.0",
              "schema_id": "https://curve.example.invalid/contracts/schemas/operation-summary.schema.json",
              "schema_path": "contracts/schemas/operation-summary.schema.json",
              "schema_content_digest": "sha256:6e33c190d6a17633b446485cd1f872ce5b051ddf049e5f615eb37927170ad50b",
              "safe_fields": [
                "schema_version",
                "id",
                "workspace_id",
                "operation_type",
                "status",
                "version",
                "progress_percent"
              ],
              "accepted_operation_types": [
                "FOUNDATION_PROBE",
                "WORKFLOW_COMMAND",
                "PROVIDER_RECONCILIATION"
              ],
              "candidate_operation_types": [
                "PROVIDER_ADMINISTRATION",
                "PROVIDER_VALIDATION",
                "PROVIDER_RECONCILIATION"
              ],
              "selected_operation_type_materialization_required": true
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/apiOperation" }
        }
      }
    },
    "apiOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "method",
        "path",
        "coarse_action",
        "granular_action",
        "authorization_resource_type",
        "lookup_sequence",
        "required_headers",
        "success_status",
        "response_kind",
        "response_contract",
        "request_body_contract",
        "operation_type_options",
        "precondition_resource",
        "response_etag_resource",
        "location"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "enum": ["LIST", "REGISTER", "READ", "VALIDATE", "RECONCILE", "DISABLE", "ENABLE", "REVOKE"]
        },
        "kind": { "type": "string", "enum": ["QUERY", "COMMAND"] },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "coarse_action": {
          "type": "string",
          "pattern": "^CURVE\\.PROVIDER_CONNECTION\\.[A-Z_]+$"
        },
        "granular_action": {
          "type": "string",
          "pattern": "^CURVE\\.PROVIDER_CONNECTION\\.[A-Z_]+$"
        },
        "authorization_resource_type": {
          "type": "string",
          "enum": ["WORKSPACE", "PROVIDER_CONNECTION"]
        },
        "lookup_sequence": {
          "type": "string",
          "enum": [
            "WORKSPACE_AUTHORIZATION_ONLY",
            "WORKSPACE_PREAUTHORIZE_SCOPED_SAFE_LOOKUP_RESOURCE_AUTHORIZE"
          ]
        },
        "required_headers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["Idempotency-Key", "If-Match"] }
        },
        "success_status": { "type": "integer", "enum": [200, 201, 202] },
        "response_kind": {
          "type": "string",
          "enum": ["CONNECTION_PAGE", "CONNECTION", "OPERATION"]
        },
        "response_contract": {
          "type": "string",
          "enum": [
            "PROVIDER_CONNECTION_ADMINISTRATION_PAGE_V1",
            "PROVIDER_CONNECTION_ADMINISTRATION_V1",
            "OPERATION_SUMMARY_V1"
          ]
        },
        "request_body_contract": {
          "type": "string",
          "enum": ["NONE", "PROVIDER_CONNECTION_REGISTER_REQUEST_V1"]
        },
        "operation_type_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SHARED_PROVIDER_ADMINISTRATION_OPERATION_V1": {
              "const": "PROVIDER_ADMINISTRATION"
            },
            "DISTINCT_VALIDATE_RECONCILE_OPERATION_TYPES_V1": {
              "type": "string",
              "enum": ["PROVIDER_VALIDATION", "PROVIDER_RECONCILIATION"]
            }
          }
        },
        "precondition_resource": {
          "type": "string",
          "enum": ["NONE", "PROVIDER_CONNECTION"]
        },
        "response_etag_resource": {
          "type": "string",
          "enum": ["NONE", "PROVIDER_CONNECTION", "OPERATION"]
        },
        "location": { "type": "boolean" }
      }
    },
    "safeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "additional_properties",
        "allowed_fields",
        "blocked_fields",
        "nested_shapes",
        "capability_digest_derivation"
      ],
      "properties": {
        "schema_version": { "const": "curve.provider-connection-administration/v1" },
        "additional_properties": { "const": false },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" }
        },
        "blocked_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" }
        },
        "nested_shapes": {
          "const": {
            "current_capability": {
              "nullable": true,
              "additional_properties": false,
              "required_fields": ["capability_version", "capability_digest"],
              "field_types": {
                "capability_version": "AGGREGATE_VERSION",
                "capability_digest": "SHA256_DIGEST"
              }
            },
            "last_error": {
              "nullable": true,
              "additional_properties": false,
              "required_fields": ["code", "retryable"],
              "field_types": {
                "code": "SAFE_ERROR_CODE",
                "retryable": "BOOLEAN"
              }
            }
          }
        },
        "capability_digest_derivation": {
          "const": {
            "algorithm": "SHA-256",
            "encoding": "UTF-8",
            "digest_prefix": "sha256:",
            "canonical_json": "RECURSIVE_LEXICOGRAPHIC_OBJECT_KEYS_COMPACT_SEPARATORS_ARRAY_ORDER_PRESERVED",
            "source_fields": [
              "adapter_key",
              "adapter_version",
              "allowed_classifications",
              "capabilities",
              "connection_id",
              "protocol_versions",
              "provider_type",
              "workspace_id"
            ],
            "capability_fields": ["enabled", "name", "risk", "schema_uri"],
            "optional_field_rule": "OMIT_CAPABILITY_SCHEMA_URI_WHEN_NULL",
            "excluded_fields": [
              "capability_version",
              "connection_version",
              "expires_at",
              "observed_at",
              "validated_at"
            ]
          }
        }
      }
    },
    "materialOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_source",
        "action_profile",
        "read_visibility",
        "membership_rule",
        "separation_rule",
        "deny_response_profile",
        "api_exposure_profile",
        "environment_classification_scope",
        "owner_reviewer_rule",
        "approval_separation_rule",
        "coding_budget_profile",
        "governance_identity_authority",
        "async_operation_profile"
      ],
      "properties": {
        "authority_source": { "$ref": "#/$defs/materialOption" },
        "action_profile": { "$ref": "#/$defs/materialOption" },
        "read_visibility": { "$ref": "#/$defs/materialOption" },
        "membership_rule": { "$ref": "#/$defs/materialOption" },
        "separation_rule": { "$ref": "#/$defs/materialOption" },
        "deny_response_profile": { "$ref": "#/$defs/materialOption" },
        "api_exposure_profile": { "$ref": "#/$defs/materialOption" },
        "environment_classification_scope": { "$ref": "#/$defs/materialOption" },
        "owner_reviewer_rule": { "$ref": "#/$defs/materialOption" },
        "approval_separation_rule": { "$ref": "#/$defs/materialOption" },
        "coding_budget_profile": { "$ref": "#/$defs/materialOption" },
        "governance_identity_authority": { "$ref": "#/$defs/materialOption" },
        "async_operation_profile": { "$ref": "#/$defs/materialOption" }
      }
    },
    "materialOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "selected"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,99}$" }
        },
        "selected": {
