{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/telemetry-manifest.schema.json",
  "title": "Curve M0 telemetry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_key",
    "manifest_version",
    "default_mode",
    "allowed_modes",
    "configuration",
    "correlation",
    "attribute_policy",
    "metric_attributes",
    "metrics",
    "spans",
    "logs",
    "dashboard",
    "alerts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_key": { "const": "CURVE_M0_TELEMETRY" },
    "manifest_version": { "const": 1 },
    "default_mode": { "const": "DISABLED" },
    "allowed_modes": {
      "const": ["DISABLED", "IN_MEMORY_TEST", "OTLP"]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_env",
        "endpoint_env",
        "protocol_env",
        "headers_env",
        "insecure_env",
        "workspace_scope_key_env",
        "workspace_scope_key_id_env",
        "explicit_endpoint_required",
        "external_default_endpoint_allowed",
        "insecure_allowed_environment"
      ],
      "properties": {
        "mode_env": { "$ref": "#/$defs/envName" },
        "endpoint_env": { "$ref": "#/$defs/envName" },
        "protocol_env": { "$ref": "#/$defs/envName" },
        "headers_env": { "$ref": "#/$defs/envName" },
        "insecure_env": { "$ref": "#/$defs/envName" },
        "workspace_scope_key_env": { "$ref": "#/$defs/envName" },
        "workspace_scope_key_id_env": { "$ref": "#/$defs/envName" },
        "explicit_endpoint_required": { "const": true },
        "external_default_endpoint_allowed": { "const": false },
        "insecure_allowed_environment": { "const": "LOCAL" }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_field",
        "trace_headers",
        "workspace_scope_algorithm",
        "workspace_scope_domain",
        "metric_identifiers_allowed",
        "audit_bridge_fields"
      ],
      "properties": {
        "application_field": { "const": "correlation_id" },
        "trace_headers": { "const": ["traceparent", "tracestate"] },
        "workspace_scope_algorithm": { "const": "HMAC-SHA256" },
        "workspace_scope_domain": { "const": "curve-workspace-scope:v1" },
        "metric_identifiers_allowed": { "const": false },
        "audit_bridge_fields": {
          "const": ["workspace_id", "correlation_id", "target_ref", "policy_decision_ref"]
        }
      }
    },
    "attribute_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_allowlist",
        "log_allowlist",
        "forbidden_name_patterns",
        "forbidden_value_classes"
      ],
      "properties": {
        "trace_allowlist": { "$ref": "#/$defs/uniqueNames" },
        "log_allowlist": { "$ref": "#/$defs/uniqueNames" },
        "forbidden_name_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "forbidden_value_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableName" }
        }
      }
    },
    "metric_attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "allowed_values"],
        "properties": {
          "name": { "$ref": "#/$defs/dottedName" },
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableName" }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/span" }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "event_codes"],
      "properties": {
        "required_fields": { "$ref": "#/$defs/uniqueNames" },
        "event_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableName" }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_path", "datasource_variable", "panels"],
      "properties": {
        "implementation_path": { "$ref": "#/$defs/repositoryPath" },
        "datasource_variable": { "const": "DS_PROMETHEUS" },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "query"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "query": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_path", "rules"],
      "properties": {
        "implementation_path": { "$ref": "#/$defs/repositoryPath" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "expression", "for", "summary"],
            "properties": {
              "id": { "$ref": "#/$defs/stableName" },
              "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
              "expression": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "for": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" },
              "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stableName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "dottedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,127}$"
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$",
      "maxLength": 1000
    },
    "uniqueNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dottedName" }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "instrument", "unit", "description", "allowed_attributes"],
      "properties": {
        "name": { "$ref": "#/$defs/dottedName" },
        "instrument": {
          "type": "string",
          "enum": ["COUNTER", "UP_DOWN_COUNTER", "HISTOGRAM", "GAUGE"]
        },
        "unit": { "type": "string", "enum": ["1", "s", "By"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "allowed_attributes": { "$ref": "#/$defs/uniqueNames" },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "allowed_attributes"],
      "properties": {
        "name": { "$ref": "#/$defs/dottedName" },
        "kind": { "type": "string", "enum": ["SERVER", "INTERNAL", "PRODUCER", "CONSUMER"] },
        "allowed_attributes": { "$ref": "#/$defs/uniqueNames" }
      }
    }
  }
}
