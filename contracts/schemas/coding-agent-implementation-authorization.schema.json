{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/coding-agent-implementation-authorization.schema.json",
  "title": "Curve coding-agent implementation authorization",
  "description": "A human-attested, time-bounded execution grant for one exact preflight-approved coding-agent task packet. The authorization is separate from packet readiness and contains no command-execution mechanism.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_version",
    "workspace_id",
    "replaces_authorization_version",
    "lifecycle_state",
    "approval_subject",
    "approval_subject_digest",
    "attestations",
    "revoked_at",
    "revocation_reason",
    "revocation_subject",
    "revocation_subject_digest",
    "revocation_attestation"
  ],
  "properties": {
    "schema_version": { "const": "curve.coding-agent-implementation-authorization/v1" },
    "authorization_id": {
      "type": "string",
      "pattern": "^CURVE-AUTH-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "authorization_version": { "type": "integer", "minimum": 1 },
    "workspace_id": { "$ref": "#/$defs/uuid" },
    "replaces_authorization_version": {
      "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
    },
    "lifecycle_state": { "enum": ["ACTIVE", "REVOKED"] },
    "approval_subject": { "$ref": "#/$defs/approvalSubject" },
    "approval_subject_digest": { "$ref": "#/$defs/sha256Digest" },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementationApprovalAttestation" }
    },
    "revoked_at": {
      "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }]
    },
    "revocation_reason": {
      "oneOf": [{ "$ref": "#/$defs/nonEmptyText" }, { "type": "null" }]
    },
    "revocation_subject": {
      "oneOf": [{ "$ref": "#/$defs/revocationSubject" }, { "type": "null" }]
    },
    "revocation_subject_digest": {
      "oneOf": [{ "$ref": "#/$defs/sha256Digest" }, { "type": "null" }]
    },
    "revocation_attestation": {
      "oneOf": [{ "$ref": "#/$defs/implementationRevocationAttestation" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "lifecycle_state": { "const": "ACTIVE" } },
        "required": ["lifecycle_state"]
      },
      "then": {
        "properties": {
          "replaces_authorization_version": { "type": "null" },
          "revoked_at": { "type": "null" },
          "revocation_reason": { "type": "null" },
          "revocation_subject": { "type": "null" },
          "revocation_subject_digest": { "type": "null" },
          "revocation_attestation": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "replaces_authorization_version": { "type": "integer", "minimum": 1 },
          "revoked_at": { "$ref": "#/$defs/instant" },
          "revocation_reason": { "$ref": "#/$defs/nonEmptyText" },
          "revocation_subject": { "$ref": "#/$defs/revocationSubject" },
          "revocation_subject_digest": { "$ref": "#/$defs/sha256Digest" },
          "revocation_attestation": { "$ref": "#/$defs/implementationRevocationAttestation" }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/|.*(?:\\.\\.|//|@\\{|\\\\|[~^:?*\\[]|\\.$|/$))[A-Za-z0-9._/-]+$"
    },
    "instant": { "type": "string", "format": "date-time" },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyText" }
    },
    "governanceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision", "path", "content_digest"],
      "properties": {
        "kind": { "const": "CURVE_MERGED_GOVERNANCE" },
        "repository": { "const": "CURVE" },
        "revision": { "$ref": "#/$defs/gitSha" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:contracts/governance|docs/technical)/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
        },
        "content_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "humanAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "authority_role",
        "actor_id",
        "actor_name",
        "subject_digest",
        "attested_at",
        "authority_receipt",
        "provenance"
      ],
      "properties": {
        "actor_type": { "const": "HUMAN" },
        "authority_role": {
          "enum": ["IMPLEMENTATION_APPROVER", "IMPLEMENTATION_REVOKER"]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.@-]+$"
        },
        "actor_name": { "$ref": "#/$defs/nonEmptyText" },
        "subject_digest": { "$ref": "#/$defs/sha256Digest" },
        "attested_at": { "$ref": "#/$defs/instant" },
        "authority_receipt": { "$ref": "#/$defs/authorityReceipt" },
        "provenance": { "$ref": "#/$defs/governanceProvenance" }
      }
    },
    "requestNonce": {
      "type": "string",
      "description": "Cryptographically random controller-generated nonce unique to one verifier request.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorityReceipt": {
      "type": "object",
      "description": "Opaque immutable receipt resolved and revocation-checked on every dispatch by a separately configured trusted human-authority verifier.",
      "additionalProperties": false,
      "required": ["kind", "reference", "content_digest", "revalidation_policy"],
      "properties": {
        "kind": { "const": "EXTERNAL_TRUSTED_HUMAN_AUTHORITY" },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "content_digest": { "$ref": "#/$defs/sha256Digest" },
        "revalidation_policy": { "const": "RECHECK_REVOCATION_EACH_DISPATCH" }
      }
    },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "content_digest", "request_nonce", "request_digest"],
      "properties": {
        "reference": { "$ref": "#/$defs/nonEmptyText" },
        "content_digest": { "$ref": "#/$defs/sha256Digest" },
        "request_nonce": { "$ref": "#/$defs/requestNonce" },
        "request_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "receiptRevocationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "checked_at", "authority_receipt_reference",
        "authority_receipt_content_digest", "request_nonce", "request_digest"
      ],
      "properties": {
        "status": { "const": "NOT_REVOKED" },
        "checked_at": { "$ref": "#/$defs/instant" },
        "authority_receipt_reference": { "$ref": "#/$defs/nonEmptyText" },
        "authority_receipt_content_digest": { "$ref": "#/$defs/sha256Digest" },
        "request_nonce": { "$ref": "#/$defs/requestNonce" },
        "request_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "trustedHumanAuthorityVerificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "action", "workspace_id", "actor_type", "actor_id",
        "actor_name", "authority_role", "subject_digest", "issued_at",
        "authority_receipt", "request_nonce", "requested_at", "request_digest"
      ],
      "properties": {
        "schema_version": { "const": "curve.trusted-human-authority-verification-request/v1" },
        "action": { "enum": ["AUTHORIZE_IMPLEMENTATION", "REVOKE_IMPLEMENTATION"] },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "actor_type": { "const": "HUMAN" },
        "actor_id": { "type": "string", "pattern": "^[A-Za-z0-9_.@-]+$" },
        "actor_name": { "$ref": "#/$defs/nonEmptyText" },
        "authority_role": { "enum": ["IMPLEMENTATION_APPROVER", "IMPLEMENTATION_REVOKER"] },
        "subject_digest": { "$ref": "#/$defs/sha256Digest" },
        "issued_at": { "$ref": "#/$defs/instant" },
        "authority_receipt": { "$ref": "#/$defs/authorityReceipt" },
        "request_nonce": { "$ref": "#/$defs/requestNonce" },
        "requested_at": { "$ref": "#/$defs/instant" },
        "request_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "trustedHumanAuthorityVerificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "decision", "action", "workspace_id", "actor_type",
        "actor_id", "actor_name", "authority_role", "subject_digest", "issued_at",
        "authority_receipt", "request_nonce", "requested_at", "request_digest",
        "verified_at", "receipt_revocation_check", "verification_receipt"
      ],
      "properties": {
        "schema_version": { "const": "curve.trusted-human-authority-verification-result/v1" },
        "decision": { "const": "VERIFIED" },
        "action": { "enum": ["AUTHORIZE_IMPLEMENTATION", "REVOKE_IMPLEMENTATION"] },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "actor_type": { "const": "HUMAN" },
        "actor_id": { "type": "string", "pattern": "^[A-Za-z0-9_.@-]+$" },
        "actor_name": { "$ref": "#/$defs/nonEmptyText" },
        "authority_role": { "enum": ["IMPLEMENTATION_APPROVER", "IMPLEMENTATION_REVOKER"] },
        "subject_digest": { "$ref": "#/$defs/sha256Digest" },
        "issued_at": { "$ref": "#/$defs/instant" },
        "authority_receipt": { "$ref": "#/$defs/authorityReceipt" },
        "request_nonce": { "$ref": "#/$defs/requestNonce" },
        "requested_at": { "$ref": "#/$defs/instant" },
        "request_digest": { "$ref": "#/$defs/sha256Digest" },
        "verified_at": { "$ref": "#/$defs/instant" },
        "receipt_revocation_check": { "$ref": "#/$defs/receiptRevocationCheck" },
        "verification_receipt": { "$ref": "#/$defs/verificationReceipt" }
      }
    },
    "implementationApprovalAttestation": {
      "allOf": [
        { "$ref": "#/$defs/humanAttestation" },
        { "properties": { "authority_role": { "const": "IMPLEMENTATION_APPROVER" } } }
      ]
    },
    "implementationRevocationAttestation": {
      "allOf": [
        { "$ref": "#/$defs/humanAttestation" },
        { "properties": { "authority_role": { "const": "IMPLEMENTATION_REVOKER" } } }
      ]
    },
    "revocationSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authorization_version",
        "replaces_authorization_version",
        "approval_subject_digest",
        "revoked_at",
        "revocation_reason"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^CURVE-AUTH-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "authorization_version": { "type": "integer", "minimum": 2 },
        "replaces_authorization_version": { "type": "integer", "minimum": 1 },
        "approval_subject_digest": { "$ref": "#/$defs/sha256Digest" },
        "revoked_at": { "$ref": "#/$defs/instant" },
        "revocation_reason": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "approvalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet",
        "workspace_id",
        "attempt_id",
        "curve",
        "repository",
        "people",
        "scope",
        "budget",
        "external_effects",
        "rollback",
        "permitted_agent_workflow_actions",
        "valid_from",
        "expires_at"
      ],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packet_id", "packet_version", "packet_digest"],
          "properties": {
            "packet_id": {
              "type": "string",
              "pattern": "^CURVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            },
            "packet_version": { "type": "integer", "minimum": 1 },
            "packet_digest": { "$ref": "#/$defs/sha256Digest" }
          }
        },
        "curve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "curve_revision", "context_digest"],
          "properties": {
            "repository": { "const": "https://github.com/faocampo/curve" },
            "curve_revision": { "$ref": "#/$defs/gitSha" },
            "context_digest": { "$ref": "#/$defs/sha256Digest" }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "target_branch", "feature_branch", "base_sha"],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?:https://|ssh://|git@)[^\\s]+$"
            },
            "target_branch": { "$ref": "#/$defs/gitRef" },
            "feature_branch": { "$ref": "#/$defs/gitRef" },
            "base_sha": { "$ref": "#/$defs/gitSha" }
          }
        },
        "people": {
          "$ref": "coding-agent-task-packet.schema.json#/properties/people"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": { "$ref": "#/$defs/nonEmptyTextList" },
            "out_of_scope": { "$ref": "#/$defs/nonEmptyTextList" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "maximum_external_spend",
            "maximum_compute_minutes",
            "on_exhaustion"
          ],
          "properties": {
            "currency": { "const": "USD" },
            "maximum_external_spend": { "type": "number", "minimum": 0 },
            "maximum_compute_minutes": { "type": "integer", "minimum": 1 },
            "on_exhaustion": { "const": "PAUSE" }
          }
        },
        "external_effects": {
          "$ref": "coding-agent-task-packet.schema.json#/properties/external_effects"
        },
        "rollback": {
          "$ref": "coding-agent-task-packet.schema.json#/properties/rollback"
        },
        "permitted_agent_workflow_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "INSPECT_AUTHORIZED_CONTEXT",
              "EDIT_AUTHORIZED_WORKTREE",
              "RUN_APPROVED_COMMANDS",
              "CREATE_CANDIDATE_TREE",
              "REQUEST_TRUSTED_CONTROLLER_EFFECTS",
              "REPORT_RESULTS"
            ]
          }
        },
        "valid_from": { "$ref": "#/$defs/instant" },
        "expires_at": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "permitted_agent_workflow_actions": {
                "contains": { "const": "REQUEST_TRUSTED_CONTROLLER_EFFECTS" }
              }
            },
            "required": ["permitted_agent_workflow_actions"]
          },
          "then": {
            "properties": {
              "external_effects": {
                "allOf": [
                  { "$ref": "coding-agent-task-packet.schema.json#/properties/external_effects" },
                  {
                    "properties": {
                      "status": { "const": "APPROVED" },
                      "mode": { "const": "TRUSTED_CONTROLLER_ONLY" },
                      "effects": { "minItems": 1 },
                      "controller_contracts": { "minItems": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
