{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/model-catalog.schema.json",
  "title": "Curve candidate model and provider route catalog",
  "x-curve-contract-state": "PROPOSED_NOT_NORMATIVE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_state",
    "catalog_id",
    "catalog_version",
    "status",
    "source_revision",
    "effective_at",
    "expires_at",
    "entries",
    "allowlist_active",
    "d004_decision_digest",
    "d005_decision_digest",
    "d014_budget_decision_digest"
  ],
  "properties": {
    "schema_version": { "const": "curve.model-catalog/v1" },
    "contract_state": { "enum": ["PROPOSED_NOT_NORMATIVE", "APPROVED_NORMATIVE"] },
    "catalog_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,99}$" },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DRAFT", "APPROVED", "EXPIRED", "REVOKED"] },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "effective_at": { "$ref": "#/$defs/nullableInstant" },
    "expires_at": { "$ref": "#/$defs/nullableInstant" },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/catalogEntry" }
    },
    "allowlist_active": { "type": "boolean" },
    "d004_decision_digest": { "$ref": "#/$defs/nullableDigest" },
    "d005_decision_digest": { "$ref": "#/$defs/nullableDigest" },
    "d014_budget_decision_digest": { "$ref": "#/$defs/nullableDigest" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "DRAFT" } }, "required": ["status"] },
      "then": { "properties": { "contract_state": { "const": "PROPOSED_NOT_NORMATIVE" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["APPROVED", "EXPIRED", "REVOKED"] } }, "required": ["status"] },
      "then": { "properties": { "contract_state": { "const": "APPROVED_NORMATIVE" } } }
    }
  ],
  "$defs": {
    "nullableDigest": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Digest" },
        { "type": "null" }
      ]
    },
    "nullableInstant": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Instant" },
        { "type": "null" }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source_revision", "content_digest", "checked_at"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "checked_at": { "$ref": "common.schema.json#/$defs/Instant" }
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "model_id",
        "model_revision",
        "provider_id",
        "provider_endpoint_id",
        "provider_policy_id",
        "capabilities",
        "context_window_tokens",
        "maximum_output_tokens",
        "supported_classifications",
        "processing_regions",
        "data_handling",
        "price",
        "lifecycle",
        "evidence_refs"
      ],
      "properties": {
        "route_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,127}$" },
        "model_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,254}$" },
        "model_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,254}$" },
        "provider_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
        "provider_endpoint_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,127}$" },
        "provider_policy_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["TEXT", "STRUCTURED_OUTPUT", "TOOL_CALLING", "STREAMING", "REASONING", "VISION"] }
        },
        "context_window_tokens": { "type": "integer", "minimum": 1 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1 },
        "supported_classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/DataClassification" }
        },
        "processing_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" }
        },
        "data_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zdr_enforced",
            "prompt_training_allowed",
            "response_training_allowed",
            "maximum_provider_retention_seconds",
            "terms_checked_at",
            "terms_evidence"
          ],
          "properties": {
            "zdr_enforced": { "type": "boolean" },
            "prompt_training_allowed": { "const": false },
            "response_training_allowed": { "const": false },
            "maximum_provider_retention_seconds": { "type": "integer", "minimum": 0 },
            "terms_checked_at": { "$ref": "common.schema.json#/$defs/Instant" },
            "terms_evidence": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "input_micro_units_per_million_tokens", "output_micro_units_per_million_tokens", "source_checked_at", "source_evidence", "d014_budget_binding_required"],
          "properties": {
            "currency": { "const": "USD" },
            "input_micro_units_per_million_tokens": { "type": "integer", "minimum": 0 },
            "output_micro_units_per_million_tokens": { "type": "integer", "minimum": 0 },
            "source_checked_at": { "$ref": "common.schema.json#/$defs/Instant" },
            "source_evidence": { "$ref": "#/$defs/evidenceRef" },
            "d014_budget_binding_required": { "const": true }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "available_from", "review_at", "retire_at"],
          "properties": {
            "status": { "enum": ["CANDIDATE", "ACTIVE", "DEPRECATED", "REVOKED"] },
            "available_from": { "$ref": "common.schema.json#/$defs/Instant" },
            "review_at": { "$ref": "common.schema.json#/$defs/Instant" },
            "retire_at": { "$ref": "#/$defs/nullableInstant" }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    }
  }
}
