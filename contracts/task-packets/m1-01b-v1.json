  "objective": {
    "demonstrable_outcome": "Implement the Curve-first Initiative navigation, paginated list, detail, create, lifecycle, concurrency, recovery, responsive, and accessible keyboard experience against the accepted M1-01A API.",
    "risk_tier": "STANDARD"
  },
  "scope": {
    "in_scope": [
      "Add typed Product, Initiative, GateAssignment, request, page, mutation, and safe-error contracts to the shared Curve TypeScript surface.",
      "Add typed Product and Initiative read/mutation methods with CSRF, idempotency, ETag, cursor, and safe rejected-response behavior.",
      "Add the first-class Curve Initiatives route and navigation link plus list, detail, create, lifecycle, recovery, responsive, and accessibility components.",
      "Add focused Vitest and React Testing Library service, state, interaction, mobile-list, form-reset, recovery, and keyboard tests."
    ],
    "out_of_scope": [
      "Backend, persistence, migration, OpenAPI, schema, policy, event, outbox, audit, idempotency-kernel, and Temporal changes.",
      "Provider, model, Onyx, MCP, VCS-controller, credential, protected-data, deployment, staging, production, and infrastructure changes.",
      "Idea Brief, evidence, research, PRD, roadmap, planning, coding-agent, quality, review, or draft-PR product behavior."
    ]
  },
